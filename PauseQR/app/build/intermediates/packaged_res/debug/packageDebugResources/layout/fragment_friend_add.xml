<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/friend_add_title"
            android:textAppearance="@style/ScanOff.Text.TitleLarge" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="@string/friend_add_desc"
            android:textAppearance="@style/ScanOff.Text.BodySmall" />

        <!-- Auswahl: Scannen oder Importieren -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/chooseSourceGroup"
            style="@style/PauseQR.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <Button
                    android:id="@+id/btnScanFriend"
                    style="@style/PauseQR.Button.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/action_scan_title" />

                <Button
                    android:id="@+id/btnImportFriend"
                    style="@style/PauseQR.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/btn_import_gallery" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Ergebnis: ungültiger Code -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/invalidGroup"
            style="@style/PauseQR.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvInvalidMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/scan_not_valid"
                android:textAppearance="@style/ScanOff.Text.BodySmall"
                android:textColor="@color/red" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Ergebnis: gültiger ScanOff-Code erkannt -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/previewGroup"
            style="@style/PauseQR.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/scan_recognized_title"
                    android:textAppearance="@style/ScanOff.Text.TitleMedium" />

                <TextView
                    android:id="@+id/tvPreviewUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textAppearance="@style/ScanOff.Text.BodyMedium" />

                <TextView
                    android:id="@+id/tvPreviewCreatedAt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/ScanOff.Text.BodySmall" />

                <ImageView
                    android:id="@+id/ivPreviewQr"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_marginTop="16dp"
                    android:background="@android:color/white"
                    android:contentDescription="@string/scan_recognized_title"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/tvPreviewNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="@style/ScanOff.Text.BodySmall"
                    android:textColor="@color/red"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnSaveAsFriend"
                    style="@style/PauseQR.Button.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/btn_save_as_friend" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
