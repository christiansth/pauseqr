<?xml version="1.0" encoding="utf-8"?>
<!-- Generischer Einzelfeld-Passwortdialog: wird für die Backup-Erstellung (bestehendes Passwort
     verifizieren), die Backup-Wiederherstellung und den Import einer eigenen QR-Identität
     verwendet – ein gemeinsames Passwortsystem, ein gemeinsamer Dialog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPasswordEnter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxStrokeColor="@color/outline"
        app:endIconMode="password_toggle"
        app:errorEnabled="true"
        app:hintTextColor="@color/text_secondary"
        app:startIconDrawable="@drawable/ic_lock_closed"
        app:startIconTint="@color/text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPasswordEnter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/password_enter_hint"
            android:inputType="textPassword"
            android:maxLength="256"
            android:singleLine="true"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
